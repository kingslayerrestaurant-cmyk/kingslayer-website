{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Serve Kingslayer Website",
      "type": "shell",
      "command": "bundle exec jekyll serve --livereload",
      "options": {
        "cwd": "${workspaceFolder}/kingslayer-site"
      },
      "isBackground": true,
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Build Kingslayer Website",
      "type": "shell",
      "command": "bundle exec jekyll build",
      "options": {
        "cwd": "${workspaceFolder}/kingslayer-site"
      },
      "problemMatcher": [],
      "group": "build"
    }
  ]
}
